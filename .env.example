# ═══════════════════════════════════════════════════════════════════════════════
# AI RAG Chatbot Configuration
# ═══════════════════════════════════════════════════════════════════════════════

# ─────────────────────────────────────────────────────────────────────────────
# 🔐 GROQ API CONFIGURATION (REQUIRED)
# ─────────────────────────────────────────────────────────────────────────────
# Get your free API key at: https://console.groq.com
# No credit card required. Completely FREE!

GROQ_API_KEY=your_groq_api_key_here


# ─────────────────────────────────────────────────────────────────────────────
# 🤖 MODEL SELECTION
# ─────────────────────────────────────────────────────────────────────────────
# Choose which Groq model to use (all are FREE)
# Options:
#   - "qwen/qwen3.6-27b", (RECOMMENDED: Fast, high quality)
#   - gemma-7b-it (Lightweight, quick responses)
#   - llama2-70b-4096 (Most powerful)
#   - openai/gpt-oss-120b (Experimental, very good)

GROQ_MODEL=mixtral-8x7b-32768


# ─────────────────────────────────────────────────────────────────────────────
# 🚀 SERVER CONFIGURATION
# ─────────────────────────────────────────────────────────────────────────────

# Server port (default: 3000)
PORT=3000

# Environment mode
# Options: development, production
NODE_ENV=development


# ─────────────────────────────────────────────────────────────────────────────
# 💾 STORAGE CONFIGURATION
# ─────────────────────────────────────────────────────────────────────────────
# Where to store documents and embeddings

# Path to documents storage
DB_PATH=./data/documents.json

# Path to embeddings storage
EMBEDDINGS_PATH=./data/embeddings.json


# ─────────────────────────────────────────────────────────────────────────────
# 🧠 RAG (Retrieval-Augmented Generation) CONFIGURATION
# ─────────────────────────────────────────────────────────────────────────────

# Maximum length of context to send to the model (in tokens)
MAX_CONTEXT_LENGTH=4000

# Maximum tokens in model response
MAX_TOKENS=2048

# Number of documents to retrieve for each query
# Higher = more context but may include less relevant docs
TOP_K_RESULTS=5

# Minimum similarity score to include a document (0.0 to 1.0)
# Lower = more documents included, Higher = only most relevant
MIN_SIMILARITY_SCORE=0.3


# ─────────────────────────────────────────────────────────────────────────────
# 📝 LOGGING CONFIGURATION
# ─────────────────────────────────────────────────────────────────────────────
# Options: ERROR, WARN, INFO, DEBUG

LOG_LEVEL=INFO


# ═══════════════════════════════════════════════════════════════════════════════
# QUICK START GUIDE
# ═══════════════════════════════════════════════════════════════════════════════
#
# 1. Get your free Groq API key:
#    Visit: https://console.groq.com
#    Sign up (free, no credit card needed)
#    Create an API key
#    Copy the key
#
# 2. Update this file:
#    Replace 'gsk_your_api_key_here_from_groq_console' with your actual key
#    Save the file
#
# 3. Start the server:
#    npm run dev
#
# 4. Test it:
#    curl -X POST http://localhost:3000/api/documents \
#      -H "Content-Type: application/json" \
#      -d '{"title":"Test","content":"Your content here"}'
#
#    curl -X POST http://localhost:3000/api/chat \
#      -H "Content-Type: application/json" \
#      -d '{"query":"Your question here"}'
#
# ═══════════════════════════════════════════════════════════════════════════════
